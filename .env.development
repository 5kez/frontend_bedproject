# Development Environment Configuration

# API Configuration - Local Development
VITE_API_BASE_URL=http://localhost:3000
VITE_WEBSOCKET_URL=http://localhost:3000

# Environment Configuration
NODE_ENV=development
VITE_APP_NAME=8BitSensor (Dev)
VITE_APP_VERSION=0.0.1-dev

# Router Configuration
VUE_ROUTER_MODE=hash
VUE_ROUTER_BASE=/

# Features Toggle - Development
VITE_ENABLE_DEBUG=true
VITE_ENABLE_LOGGING=true

# Notification Settings
VITE_NOTIFICATION_TIMEOUT=5000
VITE_WEBSOCKET_RECONNECT_ATTEMPTS=10
VITE_WEBSOCKET_RECONNECT_DELAY=1000

# File Upload Settings
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,txt

# Authentication
VITE_TOKEN_STORAGE_KEY=auth_token_dev
VITE_REFRESH_TOKEN_KEY=refresh_token_dev
VITE_TOKEN_EXPIRY_BUFFER=300000

# UI Settings
VITE_ITEMS_PER_PAGE=5
VITE_TABLE_ROWS_PER_PAGE=5,10,15
VITE_CHART_REFRESH_INTERVAL=10000
