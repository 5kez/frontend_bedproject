# API Configuration
VITE_API_BASE_URL=https://backendbedproject-production.up.railway.app
VITE_WEBSOCKET_URL=wss://backendbedproject-production.up.railway.app

# Local Development URLs (uncomment for local development)
# VITE_API_BASE_URL=http://localhost:3000
# VITE_WEBSOCKET_URL=http://localhost:3000

# Google Maps (required for location-picker features - get your own key at
# https://console.cloud.google.com/, restrict it by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY=changeme

# MQTT (real-time sensor broker, only needed if connecting directly)
VITE_MQTT_BROKER_HOST=localhost
VITE_MQTT_BROKER_PORT=1883
VITE_MQTT_WEBSOCKET_PORT=8083
VITE_MQTT_PROTOCOL=ws

# Environment Configuration
NODE_ENV=development
VITE_APP_NAME=8BitSensor
VITE_APP_VERSION=0.0.1

# Router Configuration
VUE_ROUTER_MODE=hash
VUE_ROUTER_BASE=/

# Features Toggle
VITE_ENABLE_DEBUG=true
VITE_ENABLE_LOGGING=true

# Notification Settings
VITE_NOTIFICATION_TIMEOUT=5000
VITE_WEBSOCKET_RECONNECT_ATTEMPTS=5
VITE_WEBSOCKET_RECONNECT_DELAY=1000

# File Upload Settings
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Authentication
VITE_TOKEN_STORAGE_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_TOKEN_EXPIRY_BUFFER=300000

# UI Settings
VITE_ITEMS_PER_PAGE=10
VITE_TABLE_ROWS_PER_PAGE=5,10,15,20
VITE_CHART_REFRESH_INTERVAL=30000
