# Production Environment Configuration

# API Configuration - Production
VITE_API_BASE_URL=https://backendbedproject-production.up.railway.app
VITE_WEBSOCKET_URL=wss://backendbedproject-production.up.railway.app

# Environment Configuration
NODE_ENV=production
VITE_APP_NAME=8BitSensor
VITE_APP_VERSION=1.0.0

# Router Configuration
VUE_ROUTER_MODE=hash
VUE_ROUTER_BASE=/

# Features Toggle - Production
VITE_ENABLE_DEBUG=false
VITE_ENABLE_LOGGING=false

# Notification Settings
VITE_NOTIFICATION_TIMEOUT=5000
VITE_WEBSOCKET_RECONNECT_ATTEMPTS=5
VITE_WEBSOCKET_RECONNECT_DELAY=2000

# File Upload Settings
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Authentication
VITE_TOKEN_STORAGE_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_TOKEN_EXPIRY_BUFFER=300000

# UI Settings
VITE_ITEMS_PER_PAGE=10
VITE_TABLE_ROWS_PER_PAGE=10,20,50
VITE_CHART_REFRESH_INTERVAL=30000
