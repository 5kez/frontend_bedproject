{
  "name": "8bit-bedsensor-project",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "8BitSensor",
  "author": "",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "npx eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "dev:local": "NODE_ENV=development quasar dev",
    "build": "quasar build",
    "build:dev": "NODE_ENV=development quasar build",
    "build:prod": "NODE_ENV=production quasar build",
    "build:staging": "NODE_ENV=staging quasar build",
    "build:demo": "VITE_DEMO=true PUBLIC_PATH=${PUBLIC_PATH:-/demo/smartbed/} quasar build",
    "dev:demo": "VITE_DEMO=true quasar dev",
    "preview": "quasar build && quasar serve dist/spa --port 8080",
    "ci:install": "npm ci --cache .npm --prefer-offline",
    "ci:build": "npm run build:prod",
    "ci:test": "npm run lint && npm run test",
    "docker:build": "docker build -t bed-sensor-frontend .",
    "docker:run": "docker run -p 80:80 bed-sensor-frontend"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "chart.js": "^4.5.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "echarts": "^6.0.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "socket.io-client": "^4.8.1",
    "vue": "^3.4.18",
    "vue-chartjs": "^5.3.2",
    "vue-echarts": "^8.0.0",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.0.12",
    "vue3-google-map": "^0.24.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^2.0.0",
    "@quasar/app-vite": "^2.1.0",
    "@quasar/cli": "^2.5.0",
    "@quasar/vite-plugin": "^1.0.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.5.9",
    "@types/vue-router": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "~5.5.3",
    "vite": "^6.0.0",
    "vite-plugin-checker": "^0.8.0",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
